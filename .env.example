# Copy to .env. NEVER commit .env.
APEX_ENV=production                 # "dev" only for local hacking (allows a throwaway signing key)
APEX_SECRET_KEY=                    # REQUIRED, >=32 random chars:  python -c "import secrets;print(secrets.token_urlsafe(48))"
APEX_ADMIN_EMAILS=you@example.com   # comma-separated; users registering with these emails get the admin role
APEX_CORS_ORIGINS=                  # e.g. http://localhost:5173 (empty = CORS disabled)
DATABASE_URL=sqlite:///./apex.db    # Postgres: postgresql+psycopg://apex:pw@db:5432/apex
APEX_MODEL_DIR=artifacts/active     # bootstrap source for the very first active model
APEX_REGISTRY_DIR=artifacts/registry
APEX_RATE_LIMIT=60                  # requests/min/IP (in-memory, per process)
POSTGRES_PASSWORD=change-me
